# API base URL. Do NOT bind the API to 0.0.0.0. See
# docs/operations/telegram-bot-lab.md, first sentence of section 2.
MKN_API_BASE_URL=http://127.0.0.1:5020

# Bot token from @BotFather.
MKN_BOT_TOKEN=

# Comma-separated pairs of <telegramUserId>:<adminId>.
# Example: 123456789:1,987654321:2
# Fill in on the device. Never commit the real values.
MKN_ADMIN_MAP=
